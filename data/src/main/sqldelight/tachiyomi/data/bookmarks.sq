CREATE TABLE bookmarks(
    _id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    chapter_id INTEGER NOT NULL,
    page_index INTEGER NOT NULL,
    scroll_position REAL,
    created_at INTEGER NOT NULL,
    note TEXT,
    FOREIGN KEY(chapter_id) REFERENCES chapters (_id)
    ON DELETE CASCADE
);

CREATE INDEX bookmarks_chapter_id_index ON bookmarks(chapter_id);

-- Prevents duplicate bookmarks for the exact same location at the DB level.
CREATE UNIQUE INDEX bookmarks_chapter_page_unique ON bookmarks(chapter_id, page_index);

getBookmarksByMangaId:
SELECT
    B._id,
    B.chapter_id,
    B.page_index,
    B.scroll_position,
    B.created_at,
    B.note,
    C.manga_id,
    C.name AS chapter_name,
    C.chapter_number
FROM bookmarks B
JOIN chapters C
ON B.chapter_id = C._id
WHERE C.manga_id = :mangaId
ORDER BY B.created_at DESC;

getAllBookmarks:
SELECT
    B._id,
    B.chapter_id,
    B.page_index,
    B.scroll_position,
    B.created_at,
    B.note,
    C.manga_id,
    C.name AS chapter_name,
    C.chapter_number,
    M.title AS manga_title,
    M.source AS source_id,
    M.favorite,
    M.thumbnail_url,
    M.cover_last_modified
FROM bookmarks B
JOIN chapters C
ON B.chapter_id = C._id
JOIN mangas M
ON C.manga_id = M._id
ORDER BY B.created_at DESC;

getBookmarkByChapterAndPage:
SELECT *
FROM bookmarks
WHERE chapter_id = :chapterId AND page_index = :pageIndex;

getBookmarkById:
SELECT *
FROM bookmarks
WHERE _id = :id;

insert:
INSERT INTO bookmarks(chapter_id, page_index, scroll_position, created_at)
VALUES (:chapterId, :pageIndex, :scrollPosition, :createdAt);

deleteById:
DELETE FROM bookmarks
WHERE _id = :id;

deleteByChapterAndPage:
DELETE FROM bookmarks
WHERE chapter_id = :chapterId AND page_index = :pageIndex;

updateNote:
UPDATE bookmarks
SET note = :note
WHERE _id = :id;

-- Page bookmarks for a manga keyed by chapter *url* instead of chapter id.
-- Backup and sync both need a stable identity: local chapter ids are reassigned
-- on restore, so they cannot round-trip through a backup file.
getPageBookmarksByMangaIdWithChapterUrl:
SELECT
    C.url AS chapter_url,
    B.page_index,
    B.scroll_position,
    B.created_at,
    B.note
FROM bookmarks B
JOIN chapters C
ON B.chapter_id = C._id
WHERE C.manga_id = :mangaId;

-- Restores a page bookmark from a backup without ever destroying local data.
-- The unique(chapter_id, page_index) index means an existing row wins: its
-- note and scroll position are only filled in when they are NULL, so a restore
-- merges bookmarks union-style (same as chapter.bookmark || dbChapter.bookmark)
-- instead of clobbering notes written on this device.
upsertFromBackup:
INSERT INTO bookmarks(chapter_id, page_index, scroll_position, created_at, note)
VALUES (:chapterId, :pageIndex, :scrollPosition, :createdAt, :note)
ON CONFLICT(chapter_id, page_index)
DO UPDATE
SET
    note = coalesce(note, :note),
    scroll_position = coalesce(scroll_position, :scrollPosition);

selectLastInsertedRowId:
SELECT last_insert_rowid();