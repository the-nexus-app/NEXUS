-- NOTE: must update MERGED_SOURCE_ID (6969) here
CREATE VIEW bookmarkedChaptersView AS
SELECT
    mangas._id AS mangaId,
    mangas.title AS mangaTitle,
    chapters._id AS chapterId,
    chapters.name AS chapterName,
    chapters.chapter_number AS chapterNumber,
    chapters.scanlator,
    chapters.read,
    chapters.last_page_read AS lastPageRead,
    mangas.source AS sourceId,
    mangas.favorite,
    mangas.thumbnail_url AS thumbnailUrl,
    mangas.cover_last_modified AS coverLastModified,
    chapters.date_upload AS dateUpload,
    chapters.last_modified_at AS bookmarkedAt
FROM mangas JOIN chapters
ON mangas._id = chapters.manga_id
WHERE favorite = 1 AND source <> 6969
AND chapters.bookmark = 1
UNION
SELECT
    mangas._id AS mangaId,
    mangas.title AS mangaTitle,
    chapters._id AS chapterId,
    chapters.name AS chapterName,
    chapters.chapter_number AS chapterNumber,
    chapters.scanlator,
    chapters.read,
    chapters.last_page_read AS lastPageRead,
    mangas.source AS sourceId,
    mangas.favorite,
    mangas.thumbnail_url AS thumbnailUrl,
    mangas.cover_last_modified AS coverLastModified,
    chapters.date_upload AS dateUpload,
    chapters.last_modified_at AS bookmarkedAt
FROM mangas
LEFT JOIN (
    SELECT merged.manga_id,merged.merge_id
    FROM merged
    GROUP BY merged.merge_id
) AS ME
ON ME.merge_id = mangas._id
JOIN chapters
ON ME.manga_id = chapters.manga_id
WHERE favorite = 1 AND source = 6969
AND chapters.bookmark = 1
ORDER BY mangaTitle, chapterNumber;

getAllBookmarkedChapters:
SELECT *
FROM bookmarkedChaptersView;
